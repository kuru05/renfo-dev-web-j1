 // Cap Web — affichage de l'historique. Aucune règle de réponse ici.
 
+// Mise en forme légère : **mot** s'affiche en gras.
+export function enGras(texte) {
+  return texte.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
+}
+
 export function renderMessages(messages, container) {
   const lignes = messages.map((msg) => {
     const li = document.createElement('li');
     const nom = document.createElement('strong');
     nom.textContent = msg.role === 'user' ? 'Vous' : 'Cap Web';
-    li.append(nom, ` : ${msg.text}`);
+    const corps = document.createRange().createContextualFragment(enGras(msg.text));
+    li.append(nom, ' : ', corps);
     if (msg.role === 'assistant') {
       li.classList.add('bot');
     }
