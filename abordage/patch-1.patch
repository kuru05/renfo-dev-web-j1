+import { it } from 'node:test';
+import assert from 'node:assert/strict';
+import { replyTo } from '../public/js/brain.js';
+
+it('répond à « merci » par une réponse propre, quelles que soient la casse et les espaces autour', () => {
+  const repli = replyTo('parle-moi de la météo');
+  assert.notEqual(replyTo('merci'), repli);
+  assert.equal(replyTo('  MERCI '), replyTo('merci'));
+  assert.ok(![replyTo('salut'), replyTo('aide'), replyTo('test')].includes(replyTo('merci')));
+});
