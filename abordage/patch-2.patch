--- /dev/null
+++ b/tests/normaliser.test.js
@@ -0,0 +1,12 @@
+import { it } from 'node:test';
+import assert from 'node:assert/strict';
+import { normaliser, replyTo } from '../public/js/brain.js';
+
+it('normaliser met le message en minuscules', () => {
+  assert.equal(normaliser('BonJour'), 'bonjour');
+});
+
+it('répond à « au revoir » par une réponse propre, quelle que soit la casse', () => {
+  assert.notEqual(replyTo('au revoir'), replyTo('parle-moi de la météo'));
+  assert.equal(replyTo('AU REVOIR'), replyTo('au revoir'));
+});
